{
  "name": "@remotemerge/nepali-date-converter",
  "version": "1.2.5",
  "private": false,
  "description": "Convert dates between Nepali (Bikram Sambat, BS) and Gregorian (AD) in JavaScript and TypeScript. Supports 1975–2099 BS, Devanagari numerals, and timezone-independent conversion, with zero runtime dependencies.",
  "keywords": [
    "ad-to-bs",
    "bikram-sambat",
    "bs-to-ad",
    "date-converter",
    "english-to-nepali-date",
    "nepal",
    "nepali",
    "nepali-calendar",
    "nepali-date",
    "nepali-date-converter",
    "nepali-miti",
    "nepali-to-english-date",
    "typescript",
    "vikram-samvat"
  ],
  "homepage": "https://github.com/remotemerge/nepali-date-converter",
  "bugs": {
    "url": "https://github.com/remotemerge/nepali-date-converter/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Madan Sapkota",
    "email": "contact+github@madansapkota.com",
    "url": "https://madansapkota.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remotemerge/nepali-date-converter.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "test": "bun test --check",
    "test:package": "bun scripts/check-package.ts",
    "test:coverage": "bun test --coverage-reporter=lcov",
    "dev": "vite --host 127.0.0.1 --port 3000",
    "preview": "vite preview",
    "build": "vite build && tsc -p tsconfig.dts.json && bun ./scripts/post-build.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "bun": ">=1.4.3 <2.0.0"
  }
}
